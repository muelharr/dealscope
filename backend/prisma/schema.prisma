datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String              @id @default(uuid())
  name              String
  email             String              @unique
  emailVerified     Boolean             @default(false)
  image             String?
  role              String              @default("user")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  accounts          Account[]
  sessions          Session[]
  wishlists         Wishlist[]
  searchHistories   SearchHistory[]
  activityLogs      ActivityLog[]
  comparisonHistory ComparisonHistory[]

  @@map("users")
}

model Account {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  providerId        String
  password          String?
  accessToken       String?
  refreshToken      String?
  idToken           String?
  expiresAt         DateTime?
  passwordExpiredAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("accounts")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  name        String
  slug        String     @unique
  description String?
  products    Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  slug     String    @unique
  logoUrl  String?
  products Product[]

  @@map("brands")
}

model Product {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId        String             @db.Uuid
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId           String             @db.Uuid
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  title             String
  slug              String             @unique
  description       String
  imageUrl          String
  currentPrice      Decimal            @db.Decimal(12, 2)
  originalPrice     Decimal            @db.Decimal(12, 2)
  dealScore         Int
  rating            Decimal            @default(0.00) @db.Decimal(3, 2)
  reviewCount       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  marketplaceOffers MarketplaceOffer[]
  priceHistories    PriceHistory[]
  wishlists         Wishlist[]
  aiSummary         AiSummary?

  @@map("products")
}

model Marketplace {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String             @unique
  logoUrl           String?
  marketplaceOffers MarketplaceOffer[]

  @@map("marketplaces")
}

model MarketplaceOffer {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String      @db.Uuid
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId    String      @db.Uuid
  marketplace      Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  price            Decimal     @db.Decimal(12, 2)
  url              String
  inStock          Boolean     @default(true)
  availabilityText String?
  availabilityType String      @default("positive")
  updatedAt        DateTime    @default(now()) @updatedAt

  @@map("marketplace_offers")
}

model PriceHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())

  @@map("price_history")
}

model Wishlist {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice Decimal? @db.Decimal(12, 2)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model SearchHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  createdAt DateTime @default(now())

  @@map("search_history")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@map("activity_log")
}

model AiSummary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @unique @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  verdict   String
  summary   String
  pros      String[]
  cons      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_summaries")
}

model ComparisonHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productIds String[]
  createdAt  DateTime @default(now())

  @@map("comparison_history")
}
