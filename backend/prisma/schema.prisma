datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

enum NotificationType {
  PRICE_ALERT
  SYSTEM
  PROMOTION
  AI_RECOMMENDATION
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryChannel {
  EMAIL
  PUSH
  WEBSOCKET
  IN_APP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Currency {
  IDR
  USD
  EUR
  GBP
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  BACKORDER
  DISCONTINUED
}


// --- MODELS ---

model User {
  id                String              @id @default(cuid())
  name              String?
  email             String              @unique
  emailVerified     Boolean             @default(false)
  image             String?
  role              String              @default("user")
  plan              String              @default("FREE")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  accounts          Account[]
  sessions          Session[]
  wishlists         Wishlist[]
  searchHistories   SearchHistory[]
  activityLogs      ActivityLog[]
  comparisonHistory ComparisonHistory[]
  priceAlerts       PriceAlert[]
  notifications     Notification[]

  @@map("users")
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  password          String?   @db.Text
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id               String    @id @default(cuid())
  sessionToken     String?   @unique
  refreshTokenHash String?   @unique
  userId           String
  expires          DateTime?
  expiresAt        DateTime?
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}


model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Notification {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  message          String
  payload          Json?
  priority         NotificationPriority @default(NORMAL)
  status           NotificationStatus   @default(PENDING)
  deliveryChannels DeliveryChannel[]
  scheduledAt      DateTime?
  sentAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  idempotencyKey   String?              @unique
  deliveries       NotificationDelivery[]

  @@index([userId, status, createdAt])
}

model NotificationDelivery {
  id                 String             @id @default(cuid())
  notificationId     String
  channel            DeliveryChannel
  status             NotificationStatus @default(PENDING)
  attempts           Int                @default(0)
  deliveredAt        DateTime?
  failedAt           DateTime?
  providerName         String?
  providerMessageId    String?            @unique
  providerStatus       String?
  lastProviderResponse Json?

  notification       Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
}

model Category {
  id          String     @id @default(cuid())
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  name        String
  slug        String     @unique
  description String?
  products    Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  logoUrl  String?
  products Product[]

  @@map("brands")
}

model Product {
  id                String             @id @default(cuid())
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId           String
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name              String
  slug              String             @unique
  description       String
  images            String[]
  dealScore         Int
  rating            Decimal            @default(0.00) @db.Decimal(3, 2)
  reviewCount       Int                @default(0)
  specifications    Json               @default("{}")
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  marketplaceOffers MarketplaceOffer[]
  priceHistories    PriceHistory[]
  wishlists         Wishlist[]
  aiSummary         AiSummary?
  priceAlerts       PriceAlert[]

  @@map("products")
}

model Marketplace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  logoUrl           String?
  marketplaceOffers MarketplaceOffer[]

  @@map("marketplaces")
}

model MarketplaceOffer {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId     String
  marketplace       Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  sellerId          String?
  productUrl        String
  price             Decimal     @db.Decimal(12, 2)
  originalPrice     Decimal     @db.Decimal(12, 2)
  currency          Currency    @default(IDR)
  stockStatus       StockStatus @default(IN_STOCK)
  shippingCost      Decimal     @default(0.00) @db.Decimal(12, 2)
  shippingEstimate  String?
  marketplaceRating Decimal?    @db.Decimal(3, 2)
  reviewCount       Int         @default(0)
  isOfficialStore   Boolean     @default(false)
  isActive          Boolean          @default(true)
  lastScrapedAt     DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  priceHistories    PriceHistory[]

  @@index([productId])
  @@index([marketplaceId])
  @@index([isActive])
  @@index([price])
  @@index([stockStatus])
  @@index([lastScrapedAt])
  @@map("marketplace_offers")
}

model PriceHistory {
  id                 String           @id @default(cuid())
  marketplaceOfferId String
  marketplaceOffer   MarketplaceOffer @relation(fields: [marketplaceOfferId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  price              Decimal          @db.Decimal(12, 2)
  originalPrice      Decimal          @db.Decimal(12, 2)
  shippingCost       Decimal          @db.Decimal(12, 2)
  currency           Currency         @default(IDR)
  stockStatus        StockStatus
  marketplaceRating  Decimal?         @db.Decimal(3, 2)
  reviewCount        Int              @default(0)
  recordedAt         DateTime         @default(now())

  @@index([marketplaceOfferId])
  @@index([productId])
  @@index([recordedAt])
  @@index([marketplaceOfferId, recordedAt])
  @@index([productId, recordedAt])
  @@map("price_histories")
}

model Wishlist {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice Decimal? @db.Decimal(12, 2)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  createdAt DateTime @default(now())

  @@map("search_history")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@map("activity_log")
}

model AiSummary {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  verdict   String
  summary   String
  pros      String[]
  cons      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_summaries")
}

model ComparisonHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productIds String[]
  createdAt  DateTime @default(now())

  @@map("comparison_history")
}

model PriceAlert {
  id                       String    @id @default(cuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId                String
  product                  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice              Decimal?  @db.Decimal(12, 2)
  targetDiscountPercentage Decimal?  @db.Decimal(5, 2)
  isEnabled                Boolean   @default(true)
  lastTriggeredAt          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([isEnabled])
  @@map("price_alerts")
}
